from transformers import pipeline
classifier = pipeline(
    "sentiment-analysis",
    model="distilbert-base-uncased-finetuned-sst-2-english"
)

1.	Simple positive and negative
examples = [
    "I love this product.",
    "This application is terrible.",
    "The service was excellent.",
    "I hate using this software."
]

for text in examples:
    print(text)
    print(classifier(text))
    print()
2.	Negation testing

examples = [
    "This product is good.",
    "This product is not good.",
    "This product is not bad.",
    "I don't hate this application.",
    "I don't like this application."
]

for text in examples:
    result = classifier(text)[0]

    print("Input:", text)
    print("Prediction:", result["label"])
    print("Confidence:", round(result["score"], 4))
print("-" * 50)


