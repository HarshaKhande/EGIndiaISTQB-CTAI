# ISTQB CT-AI 5.1.7
# Hands-on Exercise: Input Data Testing

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# --------------------------------------------------
# STEP 1: CREATE A SAMPLE DATASET
# --------------------------------------------------

data = {
    "Customer_ID": [101, 102, 103, 104, 105, 106, 106, 108, 109, 110],
    "Age": [25, 32, 45, np.nan, 29, 35, 35, 150, 41, 28],
    "Salary": [30000, 45000, 60000, 50000, np.nan,
               55000, 55000, 70000, 5000000, 40000],
    "Balance": [5000, 10000, 15000, 8000, 12000,
                9000, 9000, 20000, 25000, 7000],
    "Loan_Approved": ["Yes", "No", "Yes", "No", "Yes",
                      "No", "No", "Yes", "Yes", "Maybe"]
}

df = pd.DataFrame(data)

print("========== ORIGINAL DATASET ==========")
print(df)

# --------------------------------------------------
# STEP 2: BASIC DATASET INSPECTION
# --------------------------------------------------

print("\n========== DATASET INFORMATION ==========")
print("Number of rows and columns:", df.shape)

print("\nColumn names:")
print(df.columns.tolist())

print("\nDataset data types and non-null values:")
df.info()

print("\nStatistical summary:")
print(df.describe())

# --------------------------------------------------
# STEP 3: TEST FOR MISSING VALUES
# --------------------------------------------------

print("\n========== MISSING VALUE TESTING ==========")

missing_values = df.isnull().sum()
print("Missing values in each column:")
print(missing_values)

total_missing = int(df.isnull().sum().sum())
print("\nTotal missing values:", total_missing)

missing_percentage = (df.isnull().sum() / len(df)) * 100
print("\nMissing value percentage per column:")
print(missing_percentage)

print("\nRows containing missing values:")
print(df[df.isnull().any(axis=1)])

# --------------------------------------------------
# STEP 4: TEST FOR DUPLICATE DATA
# --------------------------------------------------

print("\n========== DUPLICATE DATA TESTING ==========")

duplicate_rows = df[df.duplicated(keep=False)]

print("Number of duplicate rows after the first occurrence:",
      int(df.duplicated().sum()))

print("\nAll rows involved in exact duplicates:")
print(duplicate_rows)

duplicate_ids = df[df["Customer_ID"].duplicated(keep=False)]

print("\nRows with repeated Customer_ID values:")
print(duplicate_ids)

print("\nNumber of repeated Customer_ID occurrences after the first:",
      int(df["Customer_ID"].duplicated().sum()))

# --------------------------------------------------
# STEP 5: DETECT OUTLIERS USING THE IQR METHOD
# --------------------------------------------------

print("\n========== OUTLIER DETECTION ==========")

def detect_outliers(dataframe, column):
    values = dataframe[column].dropna()

    q1 = values.quantile(0.25)
    q3 = values.quantile(0.75)
    iqr = q3 - q1

    lower_bound = q1 - 1.5 * iqr
    upper_bound = q3 + 1.5 * iqr

    outliers = dataframe[
        (dataframe[column] < lower_bound) |
        (dataframe[column] > upper_bound)
    ]

    print(f"\nColumn: {column}")
    print("Q1:", q1)
    print("Q3:", q3)
    print("IQR:", iqr)
    print("Lower bound:", lower_bound)
    print("Upper bound:", upper_bound)

    if outliers.empty:
        print("No potential outliers detected.")
    else:
        print("Potential outliers:")
        print(outliers[["Customer_ID", column]])

    return outliers

age_outliers = detect_outliers(df, "Age")
salary_outliers = detect_outliers(df, "Salary")
balance_outliers = detect_outliers(df, "Balance")

# --------------------------------------------------
# STEP 6: VISUALIZE OUTLIERS USING BOXPLOTS
# --------------------------------------------------

print("\n========== OUTLIER VISUALIZATION ==========")

plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.boxplot(df["Age"].dropna())
plt.title("Age Outliers")
plt.ylabel("Age")

plt.subplot(1, 3, 2)
plt.boxplot(df["Salary"].dropna())
plt.title("Salary Outliers")
plt.ylabel("Salary")

plt.subplot(1, 3, 3)
plt.boxplot(df["Balance"].dropna())
plt.title("Balance Outliers")
plt.ylabel("Balance")

plt.tight_layout()
plt.show()

# --------------------------------------------------
# STEP 7: TEST DATA VALIDITY AND CONSTRAINTS
# --------------------------------------------------

print("\n========== DATA VALIDITY TESTING ==========")

# Exercise rule: customer age must be between 18 and 100
invalid_age = df[
    (df["Age"] < 18) | (df["Age"] > 100)
]

print("Customers with invalid ages:")
print(invalid_age[["Customer_ID", "Age"]])

# Exercise rule: salary cannot be negative
invalid_salary = df[df["Salary"] < 0]

print("\nCustomers with negative salaries:")
print(invalid_salary[["Customer_ID", "Salary"]])

# Allowed loan approval values are Yes or No
valid_loan_status = ["Yes", "No"]

invalid_loan = df[
    ~df["Loan_Approved"].isin(valid_loan_status)
]

print("\nCustomers with invalid loan approval values:")
print(invalid_loan[["Customer_ID", "Loan_Approved"]])

# --------------------------------------------------
# STEP 8: GENERATE A DATA QUALITY REPORT
# --------------------------------------------------

print("\n========== DATA QUALITY REPORT ==========")

report = {
    "Total Records": len(df),
    "Total Columns": len(df.columns),
    "Total Missing Values": total_missing,
    "Duplicate Rows": int(df.duplicated().sum()),
    "Repeated Customer ID Occurrences": int(
        df["Customer_ID"].duplicated().sum()
    ),
    "Invalid Ages": len(invalid_age),
    "Negative Salaries": len(invalid_salary),
    "Invalid Loan Status Values": len(invalid_loan),
    "Potential Age Outliers": len(age_outliers),
    "Potential Salary Outliers": len(salary_outliers),
    "Potential Balance Outliers": len(balance_outliers)
}

for test_name, result in report.items():
    print(f"{test_name}: {result}")

# --------------------------------------------------
# STEP 9: OPTIONAL DATA CLEANING
# --------------------------------------------------

print("\n========== DATA CLEANING ==========")

clean_df = df.copy()

# Remove exact duplicate rows
clean_df = clean_df.drop_duplicates()

# Remove ages outside the exercise's valid range.
# Missing ages are retained for later imputation.
clean_df = clean_df[
    clean_df["Age"].isna() |
    clean_df["Age"].between(18, 100)
]

# Remove rows with invalid loan status values
clean_df = clean_df[
    clean_df["Loan_Approved"].isin(["Yes", "No"])
]

# Fill missing numeric values using column medians
for column in ["Age", "Salary", "Balance"]:
    clean_df[column] = clean_df[column].fillna(
        clean_df[column].median()
    )

print("Cleaned dataset:")
print(clean_df)

print("\nMissing values after cleaning:")
print(clean_df.isnull().sum())

print("\nRemaining exact duplicate rows:",
      int(clean_df.duplicated().sum()))

print("\n========== LAB COMPLETED ==========")

