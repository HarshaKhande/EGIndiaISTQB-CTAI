# Imports the function to split data into training and testing sets

from sklearn.tree import DecisionTreeClassifier
# Imports the Decision Tree machine learning classification algorithm

from sklearn.metrics import accuracy_score
# Imports the function to measure overall prediction accuracy

from sklearn.metrics import precision_score
# Imports the function to calculate precision

from sklearn.metrics import recall_score
# Imports the function to calculate recall

from sklearn.metrics import f1_score
# Imports the function to calculate F1-score

from sklearn.metrics import confusion_matrix
# Imports the function to create a confusion matrix

from sklearn.metrics import classification_report
# Imports a function to display all classification metrics


# STEP 2: LOAD THE DATASET

iris = load_iris()
# Loads the Iris dataset containing 150 flower samples

X = iris.data
# Stores 4 input features: sepal length, sepal width,
# petal length and petal width

y = iris.target
# Stores the expected flower species as 0, 1 or 2

print("Total Samples:", len(X))
# Displays the total number of flower samples

print("Flower Categories:", iris.target_names)
# Displays the three flower species


# STEP 3: SPLIT TRAINING AND TEST DATA

X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.20,    # Reserves 20% of data for testing
    random_state=42,  # Ensures reproducible data splitting
    stratify=y         # Preserves species proportions
)

print("Training Samples:", len(X_train))
# Displays the number of samples used for training

print("Testing Samples:", len(X_test))
# Displays the number of samples reserved for testing


# STEP 4: CREATE THE ML MODEL

model = DecisionTreeClassifier(
    max_depth=3,       # Limits how deep the tree can grow
    random_state=42    # Makes model behaviour reproducible
)
# Creates a Decision Tree classification model


# STEP 5: TRAIN THE MODEL

model.fit(X_train, y_train)
# Teaches the model using measurements and correct species labels

print("Model Training Completed")


# STEP 6: MAKE PREDICTIONS

y_pred = model.predict(X_test)
# Predicts flower species for the 30 unseen testing samples


# STEP 7: CALCULATE ACCURACY

accuracy = accuracy_score(y_test, y_pred)
# Calculates correct predictions / total predictions


# STEP 8: CALCULATE PRECISION

precision = precision_score(
    y_test, y_pred, average="macro", zero_division=0
)
# Calculates precision for each flower species
# Then takes the average across all 3 species


# STEP 9: CALCULATE RECALL

recall = recall_score(
    y_test, y_pred, average="macro", zero_division=0
)
# Calculates how many actual flowers of each species
# were correctly identified, then averages across classes


# STEP 10: CALCULATE F1-SCORE

f1 = f1_score(
    y_test, y_pred, average="macro", zero_division=0
)
# Calculates F1 for each class using precision and recall
# Then averages the 3 class-specific F1-scores


# STEP 11: DISPLAY PERFORMANCE METRICS

print("\n===== MODEL PERFORMANCE =====")

print("Accuracy :", round(accuracy * 100, 2), "%")
# Displays overall accuracy as a percentage

print("Precision:", round(precision * 100, 2), "%")
# Displays macro-average precision as a percentage

print("Recall   :", round(recall * 100, 2), "%")
# Displays macro-average recall as a percentage

print("F1-score :", round(f1 * 100, 2), "%")
# Displays macro-average F1-score as a percentage


# STEP 12: DISPLAY CONFUSION MATRIX

cm = confusion_matrix(y_test, y_pred)
