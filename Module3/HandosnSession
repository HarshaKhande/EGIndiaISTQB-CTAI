# Import required libraries
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score, classification_report

# 1. Load the Iris dataset
iris = load_iris()
X = iris.data             # Input features
y = iris.target           # Expected flower species

# 2. Split data: 60% training, 20% validation, 20% test
X_train_val, X_test, y_train_val, y_test = train_test_split(
    X, y, test_size=0.20, random_state=42, stratify=y
)

X_train, X_val, y_train, y_val = train_test_split(
    X_train_val, y_train_val,
    test_size=0.25, random_state=42, stratify=y_train_val
)

print("Training samples:", len(X_train))
print("Validation samples:", len(X_val))
print("Test samples:", len(X_test))

# 3. Train a classification model
model = DecisionTreeClassifier(max_depth=2, random_state=42)
model.fit(X_train, y_train)

# 4. Evaluate using VALIDATION data
val_predictions = model.predict(X_val)
val_accuracy = accuracy_score(y_val, val_predictions)

print("\nInitial Validation Accuracy:", val_accuracy)

# 5. Tune the hyperparameter using validation data
best_accuracy = -1
best_depth = None

for depth in [1, 2, 3, 4, 5]:
    candidate = DecisionTreeClassifier(
        max_depth=depth, random_state=42
    )
    candidate.fit(X_train, y_train)

    predictions = candidate.predict(X_val)
    accuracy = accuracy_score(y_val, predictions)

    print("Depth:", depth, "Validation Accuracy:", accuracy)

    if accuracy > best_accuracy:
        best_accuracy = accuracy
        best_depth = depth

print("\nBest Depth:", best_depth)
print("Best Validation Accuracy:", best_accuracy)

# 6. Retrain using selected hyperparameter
# Combine training and validation data
final_model = DecisionTreeClassifier(
    max_depth=best_depth, random_state=42
)
final_model.fit(X_train_val, y_train_val)

# 7. Test using INDEPENDENT test data
test_predictions = final_model.predict(X_test)
test_accuracy = accuracy_score(y_test, test_predictions)

print("\nIndependent Test Accuracy:", test_accuracy)
print("\nClassification Report:")
print(classification_report(
    y_test, test_predictions, target_names=iris.target_names
))

# 8. Compare validation and test results
print("\nValidation Accuracy:", best_accuracy)
print("Test Accuracy:", test_accuracy)
print("Accuracy Difference:", abs(best_accuracy - test_accuracy))

# 9. Check acceptance criteria
required_accuracy = 0.90

if test_accuracy >= required_accuracy:
    print("PASS - Model meets test accuracy requirement")
else:
    print("FAIL - Model does not meet accuracy requirement")


