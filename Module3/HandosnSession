# STEP 1: IMPORT LIBRARIES
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.datasets import load_breast_cancer
from sklearn.model_selection import train_test_split
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import StandardScaler
from sklearn.pipeline import Pipeline

# ============================================================
# STEP 2: LOAD DATASET
# ============================================================

# Load the built-in breast cancer dataset
data = load_breast_cancer(as_frame=True)

# Convert dataset into Pandas DataFrame
df = data.frame.copy()

# Display first five records
print("\nFirst 5 Records:")
print(df.head())

# Display dataset shape
print("\nDataset Shape:", df.shape)

# Display data types
print("\nData Types:")
print(df.dtypes)

# ============================================================
# STEP 3: INTRODUCE SAMPLE DATA QUALITY ISSUES
# ============================================================

# Add missing values for practice
df.loc[0:9, "mean radius"] = np.nan

# Add duplicate rows for practice
df = pd.concat(
    [df, df.iloc[:5]],
    ignore_index=True
)

print("\nMissing Values Before Cleaning:")
print(df.isnull().sum())

print("\nDuplicates Before Cleaning:")
print(df.duplicated().sum())

# ============================================================
# STEP 4: DATA CLEANING
# ============================================================

# Remove duplicate records
df = df.drop_duplicates().reset_index(drop=True)

print("\nDuplicates After Cleaning:")
print(df.duplicated().sum())

# Missing values will be handled later using median imputation
# after splitting the data to avoid data leakage.

# ============================================================
# STEP 5: EXPLORATORY DATA ANALYSIS (EDA)
# ============================================================

# Display statistical information
print("\nStatistical Summary:")
print(df.describe())

# Display target distribution
print("\nTarget Distribution:")
print(df["target"].value_counts())

# Plot target classes
df["target"].value_counts().sort_index().plot(
    kind="bar"
)

plt.title("Breast Cancer Class Distribution")
plt.xlabel("Class (0 = Malignant, 1 = Benign)")
plt.ylabel("Number of Samples")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# Plot relationship between two features
plt.scatter(
    df["mean radius"],
    df["mean texture"],
    c=df["target"],
    alpha=0.6
)

plt.title("Mean Radius vs Mean Texture")
plt.xlabel("Mean Radius")
plt.ylabel("Mean Texture")
plt.colorbar(label="Target Class")
plt.tight_layout()
plt.show()

# ============================================================
# STEP 6: FEATURE SELECTION
# ============================================================

# Select four numerical input features
features = [
    "mean radius",
    "mean texture",
    "mean perimeter",
    "mean area"
]

# X contains input features
X = df[features]

# y contains output labels
y = df["target"]

print("\nSelected Features:")
print(X.head())

print("\nTarget Values:")
print(y.head())

# ============================================================
# STEP 7: SPLIT DATASET
# ============================================================

# Split dataset into training+validation and test data
X_train_val, X_test, y_train_val, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# Split training+validation into training and validation
X_train, X_val, y_train, y_val = train_test_split(
    X_train_val,
    y_train_val,
    test_size=0.25,
    random_state=42,
    stratify=y_train_val
)

print("\nTraining Samples:", len(X_train))
print("Validation Samples:", len(X_val))
print("Testing Samples:", len(X_test))

# ============================================================
# STEP 8: DATA PREPROCESSING
# ============================================================

# Create preprocessing pipeline
preprocessor = Pipeline([
    # Replace missing values using training-data median
    ("imputer", SimpleImputer(strategy="median")),

    # Standardize numerical feature values
    ("scaler", StandardScaler())
])

# Learn preprocessing parameters using training data only
X_train_ready = preprocessor.fit_transform(X_train)

# Apply same transformations to validation data
X_val_ready = preprocessor.transform(X_val)

# Apply same transformations to test data
X_test_ready = preprocessor.transform(X_test)

print("\nTraining Data Shape:", X_train_ready.shape)
print("Validation Data Shape:", X_val_ready.shape)
print("Testing Data Shape:", X_test_ready.shape)

# ============================================================
# STEP 9: VERIFY DATA QUALITY
# ============================================================

# Check if any missing values remain
print("\nMissing Values in Training Data:",
      np.isnan(X_train_ready).sum())

print("Missing Values in Validation Data:",
      np.isnan(X_val_ready).sum())

print("Missing Values in Testing Data:",
      np.isnan(X_test_ready).sum())

# Check transformed feature means
print("\nTraining Feature Means:")
print(np.mean(X_train_ready, axis=0))

# Check transformed feature standard deviations
print("\nTraining Feature Standard Deviations:")
print(np.std(X_train_ready, axis=0))

# ============================================================
# STEP 10: SAVE PREPARED DATASETS
# ============================================================

# Convert processed arrays into DataFrames
train_df = pd.DataFrame(
    X_train_ready,
    columns=features
)

val_df = pd.DataFrame(
    X_val_ready,
    columns=features
)

test_df = pd.DataFrame(
    X_test_ready,
    columns=features
)

# Add corresponding target labels
train_df["target"] = y_train.to_numpy()
val_df["target"] = y_val.to_numpy()
test_df["target"] = y_test.to_numpy()

# Export datasets to CSV files
train_df.to_csv("prepared_training_data.csv", index=False)
val_df.to_csv("prepared_validation_data.csv", index=False)
test_df.to_csv("prepared_testing_data.csv", index=False)

# Save fitted preprocessing pipeline for future use
import joblib
joblib.dump(preprocessor, "preprocessor.joblib")

print("\nAll prepared datasets saved successfully!")

print("\nPrepared Training Data:")
print(train_df.head())

print("\nDATA PREPARATION COMPLETED SUCCESSFULLY!")

# Dataset is ready for supervised classification model training.



